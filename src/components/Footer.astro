---
import { site, socials, pages, externalLinks } from '@/utils/content';
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="flex flex-col gap-4">
        <p class="section-label">Get in touch</p>
        <a
          href={`mailto:${site.email}`}
          class="btn btn-primary text-sm"
          style="font-size: 0.875rem; width: fit-content;"
        >
          {site.email}
        </a>
        <ul class="list-none m-0 p-0 flex flex-wrap gap-3" role="list">
          {socials.map(({ label, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer me"
                class="nav-link"
                style="font-size: 0.8125rem;"
              >
                {label} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Site">
        <p class="section-label" style="margin-bottom: 0.75rem;">Site</p>
        <ul class="list-none m-0 p-0 flex flex-col gap-1" role="list">
          {pages.map(({ label, href }) => (
            <li>
              <a href={href} class="nav-link" style="font-size: 0.8125rem;">{label}</a>
            </li>
          ))}
          <li>
            <a href="/rss.xml" class="nav-link" style="font-size: 0.8125rem;">RSS feed</a>
          </li>
          <li>
            <a href="/sitemap.xml" class="nav-link" style="font-size: 0.8125rem;">Sitemap</a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Elsewhere">
        <p class="section-label" style="margin-bottom: 0.75rem;">Elsewhere</p>
        <ul class="list-none m-0 p-0 flex flex-col gap-1" role="list">
          {externalLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="nav-link"
                style="font-size: 0.8125rem;"
              >
                {label} ↗
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="credits-roll mt-10 pt-8" style="border-top: 1px solid var(--border);">
      <p style="color: var(--muted); font-size: 0.8125rem; line-height: 1.8;">
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" style="color: var(--fg);">Astro</a>
        ·
        <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" style="color: var(--fg);">Tailwind CSS</a>
        ·
        <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" style="color: var(--fg);">Vercel</a>
      </p>
      <p style="color: var(--muted); font-size: 0.75rem; margin-top: 0.75rem;">
        &copy; {new Date().getFullYear()}{' '}
        <a href="/about" style="color: inherit;">{site.name}</a>
        &middot; Surat, Gujarat
      </p>
    </div>
  </div>
</footer>
