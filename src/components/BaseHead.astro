---
import { site } from '@/utils/content';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  tags?: string[];
  jsonLd?: object[];
}

const {
  title,
  description,
  ogImage = '/og/home.png',
  ogImageAlt,
  canonical,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  articleAuthor,
  tags = [],
  jsonLd = [],
} = Astro.props;

const siteUrl = site.siteUrl;

const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();

const ogImageAbsolute = new URL(ogImage, siteUrl).toString();
const imageAlt = ogImageAlt ?? title;
const robotsContent = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large';

const personSchema = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: site.name,
  url: siteUrl,
  email: site.email,
  jobTitle: site.role,
  worksFor: {
    '@type': 'Organization',
    name: site.worksFor,
    url: site.worksForUrl,
  },
  sameAs: [
    'https://github.com/TheRakeshPurohit',
    'https://linkedin.com/in/therakeshpurohit',
    'https://x.com/irakeshpurohit',
  ],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: site.name,
  url: siteUrl,
  description: site.summary,
  inLanguage: 'en',
  author: { '@id': `${siteUrl}/#person` },
};

const graph = [personSchema, websiteSchema, ...jsonLd];
---

<!-- Document -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Theme colour (both schemes) -->
<meta name="theme-color" content="#111010" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#F2EEE4" media="(prefers-color-scheme: light)" />

<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="author" content={site.name} />
<meta name="creator" content={site.name} />
<meta name="publisher" content={site.name} />

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- Rel me / author (social verification) -->
<link rel="author" href={`${siteUrl}/about`} />
<link rel="me" href="https://github.com/TheRakeshPurohit" />
<link rel="me" href="https://linkedin.com/in/therakeshpurohit" />
<link rel="me" href="https://x.com/irakeshpurohit" />

<!-- Sitemap -->
<link rel="sitemap" href={`${siteUrl}/sitemap.xml`} />

<!-- RSS autodiscovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.name} · Writing`}
  href={`${siteUrl}/rss.xml`}
/>

<!-- Favicon & icons -->
<link
  rel="icon"
  type="image/svg+xml"
  href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='4' fill='%23D4A853'/><text x='6' y='24' font-size='22' font-family='Georgia,serif' fill='%23111010' font-weight='700'>R</text></svg>"
/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Article-specific OG -->
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime  && <meta property="article:modified_time"  content={modifiedTime} />}
{(articleAuthor ?? (type === 'article' ? site.name : null)) &&
  <meta property="article:author" content={articleAuthor ?? site.name} />
}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@irakeshpurohit" />
<meta name="twitter:creator" content="@irakeshpurohit" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbsolute} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Preconnect for Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

<!-- JSON-LD -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
/>
