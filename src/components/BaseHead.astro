---
import { site, socials, externalLinks } from '@/utils/content';
import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import spaceGroteskWoff2 from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  tags?: string[];
  jsonLd?: object[];
}

const {
  title,
  description,
  ogImage = '/og/home.png',
  ogImageAlt,
  canonical,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  articleAuthor,
  tags = [],
  jsonLd = [],
} = Astro.props;

const siteUrl = site.siteUrl;

const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();

const ogImageAbsolute = new URL(ogImage, siteUrl).toString();
const imageAlt = ogImageAlt ?? title;
const robotsContent = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const sameAs = [
  ...socials.map((s) => s.href),
  ...externalLinks
    .filter((l) =>
      ['Rocket author page', 'DhiWise author page', 'Gujarati React docs'].includes(
        l.label,
      ),
    )
    .map((l) => l.href),
];

const personSchema = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: site.name,
  url: siteUrl,
  email: site.email,
  jobTitle: site.role,
  description: site.summary,
  image: `${siteUrl}/og/home.png`,
  knowsAbout: [...site.knowsAbout],
  worksFor: {
    '@type': 'Organization',
    name: site.worksFor,
    url: site.worksForUrl,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Surat',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  sameAs,
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: site.name,
  url: siteUrl,
  description: site.summary,
  inLanguage: 'en',
  publisher: { '@id': `${siteUrl}/#person` },
  author: { '@id': `${siteUrl}/#person` },
};

const graph = [personSchema, websiteSchema, ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<meta name="theme-color" content="#111010" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#F2EEE4" media="(prefers-color-scheme: light)" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<meta name="author" content={site.name} />
<meta name="creator" content={site.name} />
<meta name="publisher" content={site.name} />

<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<link rel="author" href={`${siteUrl}/about`} />
{socials.map(({ href }) => (
  <link rel="me" href={href} />
))}

<link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap.xml`} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.name} · Writing`}
  href={`${siteUrl}/rss.xml`}
/>

<link
  rel="icon"
  type="image/svg+xml"
  href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='4' fill='%23D4A853'/><text x='6' y='24' font-size='22' font-family='Georgia,serif' fill='%23111010' font-weight='700'>R</text></svg>"
/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{(articleAuthor ?? (type === 'article' ? site.name : null)) && (
  <meta property="article:author" content={articleAuthor ?? site.name} />
)}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@irakeshpurohit" />
<meta name="twitter:creator" content="@irakeshpurohit" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbsolute} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="preload" href={frauncesWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={spaceGroteskWoff2} as="font" type="font/woff2" crossorigin />

<script
  type="application/ld+json"
  set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
/>
