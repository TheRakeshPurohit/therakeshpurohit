---
import Base from '@/layouts/Base.astro';
import { site, experience, recognition, socials } from '@/utils/content';

const title = `About · ${site.name}`;
const description =
  'DevRel Engineer at Rocket (rocket.new). Five years of technical content, community, and frontend engineering in Surat — relocating to Bengaluru.';

const jsonLd = [
  {
    '@type': 'AboutPage',
    '@id': `${site.siteUrl}/about#about`,
    url: `${site.siteUrl}/about`,
    name: `About ${site.name}`,
    description,
    isPartOf: { '@id': `${site.siteUrl}/#website` },
    mainEntity: { '@id': `${site.siteUrl}/#person` },
  },
];
---

<Base {title} {description} ogImage="/og/about.png" canonical="/about" {jsonLd}>
  <div class="container" style="padding-block: clamp(3rem, 8vw, 6rem);">

    <!-- Header -->
    <header class="mb-16" style="max-width: 38rem;">
      <span class="section-label">About</span>
      <h1 class="hero-name" style="font-size: clamp(3rem, 8vw, 6rem); margin-bottom: 1.5rem;">
        {site.name}
      </h1>
      <p class="rh-body" style="font-size: 1.125rem; color: var(--fg);">
        DevRel Engineer at Rocket (rocket.new). I lead technical content,
        content strategy and community. I write about AI agents, MCP and AI app
        building, and I build with the tools I write about — because I can't
        fake the tech, and I don't want to.
      </p>
      <p class="rh-body" style="margin-top: 1rem;">
        Based in Surat, Gujarat. Relocating to Bengaluru, available for
        in-office full-time.
      </p>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href={`mailto:${site.email}`} class="btn btn-primary">{site.email}</a>
        {socials.map(({ label, href }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            style="font-size: 0.875rem;"
          >
            {label} ↗
          </a>
        ))}
      </div>
    </header>

    <!-- The superpower -->
    <section aria-labelledby="superpower-heading" class="mb-16">
      <h2 id="superpower-heading" class="section-title" style="font-size: 1.75rem;">
        <span class="section-label">The short version</span>
        I write and ship code.
      </h2>
      <div class="rh-layout">
        <div>
          <p class="rh-body">
            I've spent five years shipping frontend code, developer tools and the
            content that explains them at Rocket. Most of what I write about —
            agents, MCP, AI app builders — I've built with first. My real skill
            is asking the right questions. I use Claude Code, Codex and Cursor
            every day, and the work is in judging what comes back: is it true, is
            it the point, would a developer roll their eyes at it?
          </p>
          <p class="rh-body" style="margin-top: 1rem;">
            I also know who's reading. I grew a Discord developer community from 0
            to 22k members, and when I rebuilt Rocket's Instagram strategy, posts
            went from about 3 likes, mostly from the team, to up to about 10k
            engagements. My taste came from turning doom scrolling into rabbit holes,
            and I don't stop until I can say the thing in one line.
          </p>
        </div>
        <aside class="rh-margin-note">
          Claude Code<br />Codex · Cursor<br />daily workflow<br />judgment first
        </aside>
      </div>
    </section>

    <!-- Experience -->
    <section aria-labelledby="experience-heading" class="mb-16">
      <h2 id="experience-heading" class="section-title" style="font-size: 1.75rem;">
        <span class="section-label">Experience</span>
        Where I've worked
      </h2>
      <div class="flex flex-col gap-8 mt-6">
        {experience.map((role) => (
          <article class="reveal" style="padding-left: 1.25rem; border-left: 2px solid var(--border);">
            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
              <div>
                <h3 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 300; color: var(--fg);">
                  {role.role}
                </h3>
                <p style="font-size: 0.875rem; color: var(--accent);">
                  {role.companyUrl
                    ? <a href={role.companyUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">{role.company}</a>
                    : role.company
                  }
                </p>
              </div>
              <span style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);">
                {role.period}
              </span>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem;">
              {role.highlights.map((h) => (
                <li style="font-size: 0.9375rem; color: var(--muted); line-height: 1.55; padding-left: 1rem; position: relative;">
                  <span style="position: absolute; left: 0; top: 0.55em; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); display: block;" aria-hidden="true"></span>
                  {h}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- Recognition -->
    <section aria-labelledby="recognition-heading" class="mb-16">
      <h2 id="recognition-heading" class="section-title" style="font-size: 1.75rem;">
        <span class="section-label">Recognition</span>
        Awards and certifications
      </h2>
      <div class="grid gap-4 sm:grid-cols-3 mt-6">
        {recognition.map((item) => (
          <div class="metric reveal">
            <p style="font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem;">{item.meta}</p>
            <p style="font-family: var(--font-serif); font-size: 1.125rem; font-weight: 300; color: var(--fg); line-height: 1.3;">{item.title}</p>
            {item.description && <p style="font-size: 0.8125rem; color: var(--muted); margin-top: 0.375rem;">{item.description}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-title" style="font-size: 1.75rem;">
        <span class="section-label">Education</span>
        Academic background
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 mt-6">
        <div class="metric reveal">
          <p style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);">2018 – 2020</p>
          <p style="font-family: var(--font-serif); font-size: 1.125rem; font-weight: 300; margin-top: 0.5rem; color: var(--fg);">MSc, Information and Communication Technology</p>
          <p style="font-size: 0.875rem; color: var(--muted); margin-top: 0.25rem;">JP Dawer Institute (VNSGU), Surat · CGPA 7.18/10</p>
        </div>
        <div class="metric reveal">
          <p style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);">2015 – 2018</p>
          <p style="font-family: var(--font-serif); font-size: 1.125rem; font-weight: 300; margin-top: 0.5rem; color: var(--fg);">Bachelor of Computer Applications</p>
          <p style="font-size: 0.875rem; color: var(--muted); margin-top: 0.25rem;">SDJ International College (VNSGU), Surat · CGPA 8.00/10</p>
        </div>
      </div>
    </section>

  </div>
</Base>
