---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { site, breadcrumbJsonLd } from '@/utils/content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateStr = new Date(post.data.date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const ogImage = `/og/${post.id}.png`;
const canonicalUrl = `/writing/${post.id}`;
const isoDate = new Date(post.data.date).toISOString();
const pageUrl = `${site.siteUrl}/writing/${post.id}`;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/writing' },
    { name: post.data.title, path: `/writing/${post.id}` },
  ]),
  {
    '@type': 'BlogPosting',
    '@id': `${pageUrl}#post`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: isoDate,
    dateModified: isoDate,
    inLanguage: 'en',
    author: { '@id': `${site.siteUrl}/#person` },
    publisher: { '@id': `${site.siteUrl}/#person` },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': pageUrl,
    },
    image: `${site.siteUrl}${ogImage}`,
    keywords: post.data.tags?.join(', '),
    isPartOf: { '@id': `${site.siteUrl}/writing#blog` },
  },
];
---

<Base
  title={`${post.data.title} · ${site.name}`}
  description={post.data.description}
  ogImage={ogImage}
  ogImageAlt={post.data.title}
  canonical={canonicalUrl}
  type="article"
  publishedTime={isoDate}
  modifiedTime={isoDate}
  articleAuthor={site.name}
  tags={post.data.tags}
  {jsonLd}
>
  <div class="container" style="padding-block: clamp(3rem, 8vw, 5rem);">

    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Writing', href: '/writing' },
        { label: post.data.title },
      ]}
    />

    <header style="max-width: 42rem; margin-bottom: 3rem;">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <time
          datetime={isoDate}
          class="post-date"
        >
          {dateStr}
        </time>
        {post.data.readTime && (
          <span class="post-date">{post.data.readTime}</span>
        )}
        {post.data.tags?.map((tag) => (
          <span style="font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);">
            {tag}
          </span>
        ))}
      </div>
      <h1
        style="
          font-family: var(--font-serif);
          font-size: clamp(2rem, 5vw, 3rem);
          font-weight: 300;
          line-height: 1.15;
          color: var(--fg);
          margin: 0 0 1rem;
        "
      >
        {post.data.title}
      </h1>
      <p style="font-size: 1.0625rem; color: var(--muted); line-height: 1.6; margin: 0;">
        {post.data.description}
      </p>
    </header>

    <article class="prose" itemprop="articleBody">
      <Content />
    </article>

    <footer style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <p style="font-size: 0.875rem; color: var(--muted);">
        By <a href="/about" style="color: var(--accent);">{site.name}</a>
        · {site.role} at{' '}
        <a href={site.worksForUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent);">
          {site.worksFor}
        </a>
        · More on <a href="/work" style="color: var(--accent);">Work</a>
        and <a href="/writing" style="color: var(--accent);">Writing</a>
      </p>
    </footer>

  </div>
</Base>
