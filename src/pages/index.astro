---
import Base from '@/layouts/Base.astro';
import { site, externalLinks } from '@/utils/content';

const title = `${site.name} · ${site.role}`;
const description = site.summary;

const rocket = externalLinks.find((l) => l.label === 'Rocket')!.href;
const author = externalLinks.find((l) => l.label === 'Rocket author page')!.href;
const ig = externalLinks.find((l) => l.label === 'Instagram @rocketdotnew')!.href;
const guReact = externalLinks.find((l) => l.label === 'Gujarati React docs')!.href;

const jsonLd = [
  {
    '@type': 'ProfilePage',
    '@id': `${site.siteUrl}/#home`,
    url: site.siteUrl,
    name: title,
    description,
    isPartOf: { '@id': `${site.siteUrl}/#website` },
    mainEntity: { '@id': `${site.siteUrl}/#person` },
  },
];
---

<Base {title} {description} ogImage="/og/home.png" {jsonLd}>

  <nav class="chapter-rail" data-section-nav aria-label="Sections">
    <a href="#chapter-surat" aria-label="Surat, 2021"></a>
    <a href="#chapter-rewrite" aria-label="Site rewrite"></a>
    <a href="#chapter-discord" aria-label="Discord"></a>
    <a href="#chapter-instagram" aria-label="Instagram"></a>
    <a href="#chapter-bylines" aria-label="Writing"></a>
    <a href="#chapter-builder" aria-label="Projects"></a>
  </nav>

  <section class="hero container" aria-labelledby="hero-name">
    <span class="hero-eyebrow">
      {site.role} ·{' '}
      <a href={rocket} target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
        {site.worksFor}
      </a>
      {' '}(<a href={rocket} target="_blank" rel="noopener noreferrer">rocket.new</a>)
    </span>

    <h1 id="hero-name" class="hero-name">
      Rakesh<br />Purohit
    </h1>

    <p class="hero-tagline">{site.tagline}</p>

    <div class="flex flex-wrap gap-3 mb-10">
      <a href="/work" class="btn btn-primary">See the work</a>
      <a href="/writing" class="btn btn-ghost">Read the writing</a>
      <a href="/about" class="btn btn-ghost">About</a>
    </div>

    <p class="scroll-hint" aria-hidden="true">Scroll</p>
  </section>

  <section id="chapter-surat" class="chapter chapter-hero" aria-label="Surat, 2021">
    <div style="position: relative; z-index: 1; padding-inline: 1.5rem;">
      <span class="chapter-timestamp">2021</span>
      <h2 class="chapter-title reveal-fade">Surat.</h2>
      <p class="chapter-subtitle reveal">Joined DhiWise. Writing and shipping from week one.</p>
    </div>
  </section>

  <section class="rabbit-hole" aria-label="Surat story">
    <div class="container">
      <div class="rh-layout">
        <div>
          <h3 class="rh-headline reveal">
            I joined a startup building a code-generation platform for developers.
            <span class="hl">
              Five years later it became{' '}
              <a href={rocket} target="_blank" rel="noopener noreferrer">Rocket</a>.
            </span>
          </h3>
          <p class="rh-body reveal">
            I started as a React developer. Within two weeks I was also writing for
            the blog, answering Discord questions, shipping Figma plugin code, and
            running a content calendar. At that size nobody called it DevRel — it was
            just the work that needed doing. Full timeline on{' '}
            <a href="/about">About</a>.
          </p>
        </div>
        <aside class="rh-margin-note" aria-label="Sidebar note">
          Apr 2021<br />Surat, Gujarat
        </aside>
      </div>
    </div>
  </section>

  <section id="chapter-rewrite" class="chapter" aria-label="Site rewrite">
    <div style="position: relative; z-index: 1; padding-inline: 1.5rem;">
      <span class="chapter-timestamp">Migration</span>
      <h2 class="chapter-title reveal-fade">Webflow<br />to Next.js.</h2>
      <p class="chapter-subtitle reveal">ISR. Organic traffic up 80% in the first quarter.</p>
    </div>
  </section>

  <section class="rabbit-hole" aria-label="Rewrite story">
    <div class="container">
      <div class="rh-layout">
        <div>
          <h3 class="rh-headline reveal">
            I migrated the marketing site to Next.js with ISR, JSON-LD, and API-based
            indexing.
          </h3>
          <p class="rh-body reveal">
            Core Web Vitals moved from 33 to 91 on desktop and 38 to 88 on mobile.
            The DhiWise blog reached 10K+ monthly readers, with pages in top-10 search
            rankings. Related samples on <a href="/work">Work</a>.
          </p>
        </div>
        <aside class="rh-margin-note" aria-label="Sidebar note">
          CWV 33→91 / 38→88<br />10K+ mo. readers
        </aside>
      </div>
    </div>
  </section>

  <section id="chapter-discord" class="chapter" aria-label="Discord">
    <div style="position: relative; z-index: 1; padding-inline: 1.5rem;">
      <span class="chapter-timestamp">Community</span>
      <h2 class="chapter-title reveal-fade">0 to<br />22k.</h2>
      <p class="chapter-subtitle reveal">Rocket Discord, built from scratch.</p>
    </div>
  </section>

  <section class="rabbit-hole" aria-label="Discord story">
    <div class="container">
      <p class="rh-body reveal" style="max-width: 40rem;">
        I use the Discord to see how developers react to the product and the content —
        what gets ignored, what gets follow-ups, which tutorials stick. Recurring
        questions become topic briefs. Complaint threads become documentation fixes.
        Campaign notes on <a href="/work">Work</a>.
      </p>
    </div>
  </section>

  <section id="chapter-instagram" class="chapter" aria-label="Instagram">
    <div style="position: relative; z-index: 1; padding-inline: 1.5rem;">
      <span class="chapter-timestamp">Social</span>
      <h2 class="chapter-title reveal-fade">3 likes<br />to ~10k.</h2>
      <p class="chapter-subtitle reveal">
        <a href={ig} target="_blank" rel="noopener noreferrer">@rocketdotnew</a> Instagram rebuild.
      </p>
    </div>
  </section>

  <section class="rabbit-hole" aria-label="Instagram story">
    <div class="container">
      <div class="rh-layout">
        <div>
          <p class="rh-body reveal">
            Early posts spoke to the team, not the ICP. I reviewed what we'd published,
            spent a week on who Rocket was trying to reach, then rewrote. Audience
            understanding fixed more than better prompts.
          </p>
          <a href="/writing/essay" class="rh-artifact reveal">
            Essay: The output is free now →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="chapter-bylines" class="chapter" aria-label="Writing">
    <div style="position: relative; z-index: 1; padding-inline: 1.5rem;">
      <span class="chapter-timestamp">Writing</span>
      <h2 class="chapter-title reveal-fade">144<br />bylines.</h2>
      <p class="chapter-subtitle reveal">AI agents, MCP, and the stack behind them.</p>
    </div>
  </section>

  <section class="rabbit-hole" aria-label="Writing story">
    <div class="container">
      <div class="rh-layout">
        <div>
          <p class="rh-body reveal">
            I build with a tool before I write about it. If I can't ship a working
            example, I don't publish. Day to day: Claude Code, Codex, and Cursor.
          </p>
          <div class="flex flex-wrap gap-4 mt-4">
            <a href="/work" class="rh-artifact reveal">Samples on Work →</a>
            <a href="/writing" class="rh-artifact reveal">Essays →</a>
            <a
              href={author}
              target="_blank"
              rel="noopener noreferrer"
              class="rh-artifact reveal"
            >
              rocket.new/author →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="chapter-builder" class="chapter" aria-label="Projects">
    <div style="position: relative; z-index: 1; padding-inline: 1.5rem;">
      <span class="chapter-timestamp">Projects</span>
      <h2 class="chapter-title reveal-fade">Shipped<br />tools.</h2>
      <p class="chapter-subtitle reveal">ReactTestGen. Figma plugin. 100K+ users.</p>
    </div>
  </section>

  <section class="rabbit-hole" aria-label="Builder story" style="border-bottom: none; padding-bottom: 4rem;">
    <div class="container">
      <p class="rh-body reveal" style="max-width: 40rem; margin-bottom: 1.5rem;">
        The Figma plugin improved core product acquisition by 30%. I maintain the{' '}
        <a href={guReact} target="_blank" rel="noopener noreferrer">Gujarati React docs</a>
        {' '}and submitted a CFP to React India 2025.
      </p>
      <a href="/projects" class="rh-artifact reveal">All projects →</a>
    </div>
  </section>

</Base>
